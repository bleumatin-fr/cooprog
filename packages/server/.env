NODE_ENV=development
PORT=3001
# MONGO_URL=mongodb://localhost:27017/coprog
MONGO_URL=mongodb://localhost:27017/cooprog
# Number of salt rounds for bcrypt when hashing passwords
PASSWORD_SALT_ROUND=10
# Secret used to sign JWT tokens
JWT_SECRET=secret1
# Validity of JWT tokens in seconds
JWT_EXPIRY=60 * 1
# Secret used to sign refresh tokens
REFRESH_TOKEN_SECRET=secret2
# Validity of refresh tokens in seconds
REFRESH_TOKEN_EXPIRY=60 * 60 * 24 * 30
# Secret used to sign the cookies containing refresh tokens
COOKIE_SECRET=secret3
# Secret used to sign the reset password tokens
RESET_PASSWORD_TOKEN_SECRET=secret4
# Validity of reset password tokens in seconds
RESET_PASSWORD_TOKEN_EXPIRY=60 * 60 * 24 * 30
# Validity of invitation tokens in seconds
INVITATION_TOKEN_EXPIRY=60 * 60 * 24 * 7
# Which URL are allowed to call our API
WHITELISTED_DOMAINS=http://localhost:3000,http://localhost:4000
# Mail server SMTP connection string
MAIL_URL=smtp://localhost:1025
# Mail address used to send emails
MAIL_FROM=no-reply@cooprog.eu
# Mail address used to receive user message
MAIL_TO=contact@cooprog.eu
# URL of the frontend
FRONTEND_URL=http://localhost:3000
# URL of the admin
ADMIN_URL=http://localhost:4000
# CRON to remove inactive users and projects, and send some notifications (every day at 8:30 GMT+1)
CRON_SCHEDULE=30 6 * * *
# CRON_SCHEDULE=* * * * *
CRON_MODERATION_SCHEDULE=0 8 * * *
# CRON to send the weekly digest mail (every monday at 8:30 GMT+1)
CRON_WEEKLY_DIGEST_SCHEDULE=30 6 * * 1
NODE_TLS_REJECT_UNAUTHORIZED=0
# LOGGER_FORMAT=json|human-readable
LOGGER_FORMAT=human-readable
UPLOAD_PATH=/app/packages/server/uploads