{
  "name": "@cooprog/server",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p .",
    "postbuild": "cp -r migrations dist",
    "start": "ts-node-dev --respawn --transpile-only --inspect=0.0.0.0:13001 src/app.ts",
    "migration:_status": "migrate-mongo status",
    "migration:_up": "migrate-mongo up",
    "migration:create": "migrate-mongo create new-migration",
    "migration:status": "dotenv-run-script .env .env.local -- migration:_status",
    "migration:up": "dotenv-run-script .env .env.local -- migration:_up",
    "test-cron": "ts-node-dev --transpile-only src/test-crons.ts"
  },
  "dependencies": {
    "@cooprog/core": "*",
    "@sentry/node": "9.43.0",
    "@sentry/profiling-node": "9.43.0",
    "@sentry/tracing": "7.120.4",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "4.1.0",
    "dompurify": "3.3.2",
    "dotenv-flow": "^3.2.0",
    "express": "^4.18.1",
    "express-async-errors": "^3.1.1",
    "express-query-boolean": "^2.0.0",
    "express-winston": "^4.2.0",
    "handlebars": "4.7.9",
    "i18next": "^24.2.3",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.7.1",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.0",
    "migrate-mongo": "14.0.7",
    "mongoose": "^6.4.2",
    "multer": "2.1.1",
    "node-cron": "^3.0.2",
    "nodemailer": "8.0.5",
    "scmp": "^2.1.0",
    "sharp": "^0.33.5",
    "supercluster": "7.1.5",
    "ts-node-dev": "^2.0.0",
    "winston": "^3.11.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.12",
    "@types/dotenv-flow": "^3.2.0",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/multer": "2.1.0",
    "@types/node": "^18.0.0",
    "@types/node-cron": "^3.0.8",
    "@types/nodemailer": "8.0.0",
    "@types/smallest-enclosing-circle": "^1",
    "@types/supercluster": "^7.1.1",
    "dotenv-run-script": "^0.2.0",
    "ts-node": "^10.8.2",
    "typescript": "5.2.2"
  }
}
